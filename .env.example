# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# ---- LLM selection -------------------------------------------------------
# Format: <provider>:<model>. Providers: anthropic | ollama | fake
# Global default for every agent:
BIOTRADEAI_LLM=ollama:llama3.2:3b
# Optional per-agent override (wins over BIOTRADEAI_LLM):
# BIOTRADEAI_LLM_RESEARCH=anthropic:claude-sonnet-5-5
# BIOTRADEAI_LLM_CRITIC=ollama:llama3.2:3b   (ToT critic; the Risk Agent uses no LLM)
# BIOTRADEAI_LLM_AGENT=anthropic:claude-sonnet-5-5   (research agent tool loop; needs tool calling)

# Embeddings for RAG: st:<model> | ollama:<model> | hash (offline tests)
# BIOTRADEAI_EMBEDDER=st:BAAI/bge-small-en-v1.5

ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# ---- Brokers -------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ---- Safety --------------------------------------------------------------
# Long random string; signs CLI approval tokens (Phase 2).
APPROVAL_HMAC_SECRET=
# Must be 1 (plus mode: live in config, plus typed confirmation) to trade live.
BIOTRADEAI_LIVE=0

# ---- Data sources --------------------------------------------------------
# SEC requires a descriptive User-Agent with contact info (Phase 1).
SEC_USER_AGENT="BioTradeAI research you@example.com"
# Optional, free. NCBI (PubMed) asks for a contact email; a key raises 3 -> 10 req/s
# (we use 2 -> 5). https://www.ncbi.nlm.nih.gov/account/
# NCBI_EMAIL=you@example.com
# NCBI_API_KEY=
# Optional, free. openFDA without a key: 1,000 requests/day per IP (we cap at 500).
# https://open.fda.gov/apis/authentication/
# OPENFDA_API_KEY=
# Never set LANGSMITH_TRACING / LANGCHAIN_TRACING_V2: they send prompts to a third party.

# ---- Paths (optional overrides) -----------------------------------------
# BIOTRADEAI_CONFIG=config/guardrails.yaml
# BIOTRADEAI_DB=data/biotradeai.db
