# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# ---- LLM selection -------------------------------------------------------
# Format: <provider>:<model>. Providers: anthropic | ollama | fake
# Global default for every agent:
BIOTRADEAI_LLM=ollama:llama3.2:3b
# Optional per-agent override (wins over BIOTRADEAI_LLM):
# BIOTRADEAI_LLM_RESEARCH=anthropic:claude-sonnet-5-5
# BIOTRADEAI_LLM_RISK=ollama:llama3.2:3b

ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# ---- Brokers -------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ---- Safety --------------------------------------------------------------
# Long random string; signs CLI approval tokens (Phase 2).
APPROVAL_HMAC_SECRET=
# Must be 1 (plus mode: live in config, plus typed confirmation) to trade live.
BIOTRADEAI_LIVE=0

# ---- Data sources --------------------------------------------------------
# SEC requires a descriptive User-Agent with contact info (Phase 1).
SEC_USER_AGENT="BioTradeAI research you@example.com"

# ---- Paths (optional overrides) -----------------------------------------
# BIOTRADEAI_CONFIG=config/guardrails.yaml
# BIOTRADEAI_DB=data/biotradeai.db
